# 数据库
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Giscus 评论（在 https://giscus.app 选择仓库与 Discussion 分类后生成）
# 仓库需为 public，并在 GitHub 仓库 Settings → General → Features 中开启 Discussions。
NEXT_PUBLIC_GISCUS_REPO="owner/repo"
NEXT_PUBLIC_GISCUS_REPO_ID="R_xxxxxxxxxx"
NEXT_PUBLIC_GISCUS_CATEGORY="Comments"
NEXT_PUBLIC_GISCUS_CATEGORY_ID="DIC_xxxxxxxxxx"

# 后台评论管理：需要具备 discussions 读写权限的 GitHub PAT（可与上传用 GITHUB_TOKEN 共用）
GISCUS_GITHUB_TOKEN="github_pat_xxxxxxxx"

# Cloudinary 图片存储（新上传图片优先使用；未配置时回退 GitHub）
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Prisma 连接数（Vercel 上默认 1；本地默认 5，可按需覆盖）
DB_CONNECTION_LIMIT="1"
